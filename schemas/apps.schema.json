{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sealedstack.dev/schemas/apps.schema.json",
  "title": "sealedstack apps.yaml",
  "description": "Placement and exposure for each app (spec section 5.3). No secrets, no IP addresses.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apps"
  ],
  "properties": {
    "apps": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "servers",
            "hostnames",
            "access"
          ],
          "properties": {
            "source": {
              "oneOf": [
                {
                  "title": "image",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "image"
                  ],
                  "properties": {
                    "image": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "title": "repo",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "repo",
                    "ref"
                  ],
                  "properties": {
                    "repo": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                    },
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "servers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "hostnames": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "redirects": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "access": {
              "type": "string",
              "minLength": 1,
              "description": "A policy name from stack.yaml gate.policies, or 'public'."
            },
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Set false to pause an app: it is skipped (not treated as unresolved), so plan/apply will not destroy it silently."
            },
            "user_auth": {
              "type": "string",
              "minLength": 1
            },
            "secrets": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Per-app secret key overrides (D-050): secret NAME -> source key (default <app>.<NAME>)."
            },
            "drill": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "false: skip this app in `drill all` and the scheduled drill."
                },
                "level": {
                  "enum": [
                    "verify",
                    "schema",
                    "sample",
                    "tables",
                    "full"
                  ]
                },
                "where": {
                  "enum": [
                    "server",
                    "runner"
                  ],
                  "description": "Where this app's throwaway Postgres runs; `runner` is structure only (levels verify and schema)."
                },
                "tables": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Tables whose full data the `tables` level restores and counts."
                },
                "min_rows": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 1,
                  "description": "Each named table must hold at least this many rows."
                },
                "sample_rows": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1,
                  "description": "Rows per table for the `sample` level."
                }
              }
            }
          }
        }
      }
    }
  }
}
