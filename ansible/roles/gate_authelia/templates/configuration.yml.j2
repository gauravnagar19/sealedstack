---
host: 0.0.0.0
port: 9091
theme: auto
log:
  level: info
identity_validation:
  reset_password:
    jwt_secret: "{{ gate_authelia_session_secret }}"
authentication_backend:
  file:
    path: /config/users_database.yml
    password:
      algorithm: argon2id
access_control:
  default_policy: deny
  rules:
    - domain: "{{ gate_authelia_domain }}"
      policy: one_factor
session:
  name: "{{ gate_authelia_session_name }}"
  secret: "{{ gate_authelia_session_secret }}"
  expiration: "{{ gate_authelia_session_expiration }}"
  redis:
    host: "{{ gate_authelia_redis_host }}"
    port: 6379
storage:
  local:
    path: /config/db.sqlite3
  encryption_key: "{{ gate_authelia_storage_key }}"
notifier:
  filesystem:
    filename: /config/notification.txt
