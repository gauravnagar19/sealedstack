---
# NetBird combined server config (mesh slot, netbird implementation).
server:
  listenAddress: ":80"
  exposedAddress: "{{ mesh_netbird_server_url }}"
  stunPorts:
    - {{ mesh_netbird_stun_port }}
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: info
  logFile: console
  authSecret: "{{ mesh_netbird_auth_secret }}"
  dataDir: /var/lib/netbird
  auth:
    issuer: "{{ mesh_netbird_server_url }}/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: "{{ mesh_netbird_session_key }}"
    dashboardRedirectURIs:
      - "{{ mesh_netbird_server_url }}/nb-auth"
      - "{{ mesh_netbird_server_url }}/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"
  reverseProxy:
    trustedHTTPProxies: []
  store:
    engine: sqlite
    encryptionKey: "{{ mesh_netbird_datastore_key }}"
