---
services:
  nginx:
    image: "{{ ingress_nginx_image }}:{{ ingress_nginx_image_tag }}"
    restart: unless-stopped
    volumes:
      - "{{ ingress_nginx_compose_dir }}/conf.d:/etc/nginx/conf.d:ro"
      - "{{ ingress_nginx_compose_dir }}/certbot/conf:/etc/letsencrypt:ro"
      - "{{ ingress_nginx_compose_dir }}/certbot/www:/var/www/certbot:ro"
    ports:
      - "{{ ingress_nginx_http_port }}:80"
      - "{{ ingress_nginx_https_port }}:443"
    networks:
      - dokploy-network
{% if ingress_nginx_hostnames | length > 0 %}
  certbot:
    image: "{{ ingress_nginx_certbot_image }}:{{ ingress_nginx_certbot_image_tag }}"
    restart: unless-stopped
    volumes:
      - "{{ ingress_nginx_compose_dir }}/certbot/conf:/etc/letsencrypt"
      - "{{ ingress_nginx_compose_dir }}/certbot/www:/var/www/certbot"
    command: >-
      sh -c "trap exit TERM; while :; do
      certbot certonly --webroot --webroot-path /var/www/certbot
      --cert-name {{ ingress_nginx_hostnames[0] }}
      {% for hostname in ingress_nginx_hostnames %}-d {{ hostname }} {% endfor %}
      --email {{ ingress_nginx_email }} --agree-tos --no-eff-email
      {% if ingress_nginx_staging | bool %}--staging {% endif %}
      --server {{ ingress_nginx_acme_ca }}
      --keep-until-expiring --non-interactive;
      sleep {{ ingress_nginx_certbot_renew_interval }} & wait $${!}; done"
{% endif %}

networks:
  dokploy-network:
    external: true
